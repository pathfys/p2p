# ─────────────────────────────────────────────────────────────────────────
# P2P Light backend — конфигурация. Скопируйте в `.env` и заполните.
# Все значения читаются и валидируются на старте (src/config.ts): любой
# некорректный или отсутствующий обязательный параметр = аварийный выход.
# ─────────────────────────────────────────────────────────────────────────

# Окружение: development | production | test.
# В production dev-обходы аутентификации запрещены (fail-fast на старте).
NODE_ENV=development

# ── Сетевые порты ──────────────────────────────────────────────────────────
# Публичный порт: REST API + апгрейд WebSocket (одно TCP-соединение, путь WS_PATH).
HTTP_PORT=8080
# Адрес прослушивания. 127.0.0.1 — только локально; за балансировщиком — 0.0.0.0.
HTTP_HOST=127.0.0.1
# Приватный порт для health/metrics. Поднимать ТОЛЬКО во внутренней сети,
# не выставлять наружу. Пусто/0 — метрик-порт не открывается.
METRICS_PORT=9090
METRICS_HOST=127.0.0.1
# Путь, по которому принимается WebSocket-апгрейд на HTTP_PORT.
WS_PATH=/v1/stream

# ── Секреты ─────────────────────────────────────────────────────────────────
# Токен бота Telegram — им проверяется подпись initData (HMAC-SHA256).
# Обязателен в production. В development можно оставить пустым, тогда включается
# dev-верификатор (см. ALLOW_DEV_AUTH).
TELEGRAM_BOT_TOKEN=
# Секрет подписи stateless-сессий (REST). >= 32 символов. Обязателен всегда.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── CORS / источники ─────────────────────────────────────────────────────────
# Разрешённые Origin мини-аппа через запятую. Пусто = запретить все
# кросс-оригин-запросы (строгий дефолт). Пример: https://app.p2plight.example
CORS_ORIGINS=

# ── Dev-обходы (игнорируются в production) ────────────────────────────────────
# true + пустой TELEGRAM_BOT_TOKEN → принимать dev-initData без подписи,
# чтобы поднять стенд без бота. В production любое true = ошибка старта.
ALLOW_DEV_AUTH=true

# ── Лимиты (кибербез) ────────────────────────────────────────────────────────
# REST: запросов в минуту на IP и на аккаунт.
RATE_HTTP_PER_MIN_IP=240
RATE_HTTP_PER_MIN_ACCOUNT=600
# Ордеров в минуту на аккаунт (создание сделок).
RATE_DEALS_PER_MIN=20
# Макс. размер тела REST-запроса, байт.
MAX_BODY_BYTES=65536
# WS: макс. соединений с одного IP; кадров/с на соединение; макс. размер кадра.
WS_MAX_CONN_PER_IP=8
WS_FRAMES_PER_SEC=300
WS_MAX_FRAME_BYTES=524288
# WS: закрыть соединение, если нет входящих кадров дольше (мс).
WS_IDLE_TIMEOUT_MS=30000

# ── Поток котировок ──────────────────────────────────────────────────────────
# Источник стаканов: generator (встроенный, без ключей бирж) | http (реальные
# адаптеры бирж — port определён, адаптер не входит в open-source сборку).
FEED_SOURCE=generator
# Период тиков генератора, мс (как часто шлём инкременты).
FEED_TICK_MS=600
