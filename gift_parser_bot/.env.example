# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

# Обязательная подписка на канал (бота нужно сделать админом канала); пусто = без проверки
REQUIRED_CHANNEL=@fiestagod

# Скорость парсера: slow | normal | fast | auto (auto сам подбирает скорость по ответам 429)
PARSER_SPEED=auto
# Запускать парсер автоматически при старте бота (1=наполнять базу сам, 0=только по /admin)
PARSER_AUTOSTART=1
# Повторный обход коллекций / обновление портфелей, часов
RECRAWL_HOURS=24
# Сколько номеров коллекции парсится за один пакет (контрольная точка в БД)
CHUNK_SIZE=50
# Парсить только коллекции с floor >= N TON (0 = все ~11.7 млн NFT; 50 = ~180 тыс. NFT, ~4 ч)
CRAWL_MIN_FLOOR_TON=0

# Пороги режимов по оценке всех NFT владельца, TON
TIER_MEDIUM_TON=30
TIER_RICH_TON=300
# Оценка подарка, если floor коллекции неизвестен, TON
DEFAULT_GIFT_TON=3

# Подарки владельца при поиске по @username
RESULTS_PER_PAGE=5
# Выдача людей: по 10 на странице, 2 страницы («След. страница» -> «Назад» / «Повторить»)
PEOPLE_PER_PAGE=10
PEOPLE_PAGES=2
# Перед выдачей проверять каждого человека живым запросом к t.me/nft (1/0)
LIVE_CHECK=1
# DB_PATH=data/gifts.db

# --- Опционально: MTProto-аккаунт (https://my.telegram.org) ---
# После заполнения один раз выполните: python -m app.login
# API_ID=
# API_HASH=
# MTPROTO_SESSION=data/parser
